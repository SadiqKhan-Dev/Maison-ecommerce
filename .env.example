# ---------------------------------------------------------------------------
# Maison — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="USD"

# --- Auth (NextAuth v5) ----------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
# AUTH_SECRET is preferred; NEXTAUTH_SECRET is read as a fallback.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# AUTH_URL is auto-detected in v5 on most hosts; set explicitly for
# preview deploys and local development.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — only required if "Continue with Google" is wired)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe ----------------------------------------------------------------
# Required for checkout. Use test keys in development.
# Test card: 4242 4242 4242 4242 — any future expiry — any CVC.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) --------------------------------------------------------
# Optional in development — falls back to data/email-log.json.
# Required in production for transactional order confirmations.
RESEND_API_KEY=""

# --- Cloudinary (image uploads) -------------------------------------------
# Optional. The site can run on the bundled Unsplash imagery only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Database (placeholder for future migration) --------------------------
# Not used by the in-memory store today. Listed here so the .env stays
# consistent when wiring Prisma / Drizzle in a future phase.
# DATABASE_URL=""
